project_id = "teamspace-one"
zone       = "asia-south1-a"
region     = "asia-south1"

# Azure DevOps clone URL (replace the placeholders)
repo_url = "https://xrlearn@dev.azure.com/xrlearn/Connect/_git/Connect"
repo_ref = "main"

# Azure DevOps PAT for private repos; leave empty for public repos
# git_token = "<PAT>"
# git_username = ""  # optional, can be left empty for Azure PATs

# openai_api_key = "sk-..."  # required for ai-service

# Email provider encryption key (generate with: openssl rand -base64 32)
# organisation_email_encryption_key = "..."

# Domain + SSL (optional but recommended). Caddy will provision Let's Encrypt certs automatically.
# domain = "teamspaceone.in"
# acme_email = "admin@teamspaceone.in"
