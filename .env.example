NODE_ENV=development
LOG_LEVEL=info

# API Gateway
GATEWAY_PORT=3000

# Postgres (multi-tenant local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=postgres
# Per-service databases are created by docker/postgres-init (hrms_db included).
# HRMS local dev: DATABASE_URL=postgresql://postgres:$POSTGRES_PASSWORD@localhost:5432/hrms_db?schema=public

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379

# NATS JetStream
NATS_USER=teamspace
NATS_PASSWORD=REPLACE_WITH_STRONG_NATS_PASSWORD
NATS_URL=nats://teamspace:REPLACE_WITH_STRONG_NATS_PASSWORD@localhost:4222

# S3-compatible (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_STRONG_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STRONG_S3_SECRET_KEY
S3_BUCKET=teamspace-one
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Native SFU (voice/video)
SFU_TOKEN_SECRET=REPLACE_WITH_STRONG_SFU_TOKEN_SECRET
# Seconds an SFU join token stays valid (default 4h).
SFU_TOKEN_TTL_SECONDS=14400
# ICE UDP mux port the SFU binds for media (published as UDP in compose).
SFU_UDP_MUX_PORT=10000
# Public IP(s) the SFU advertises as ICE candidates when behind 1:1 NAT.
# Local dev default is 127.0.0.1; set to the server's public IP in deployed envs.
SFU_NAT_1TO1_IPS=127.0.0.1
# Internal control API (recording on/off); meeting-service calls this.
SFU_CONTROL_URL=http://localhost:8445
# Directory inside the SFU where per-track recordings are written before upload.
SFU_RECORDING_DIR=./recordings
# Max participants per call room (default 100).
SFU_MAX_PARTICIPANTS_PER_ROOM=100

# Service-to-service auth (required for all services)
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY

# JWT signing secret (required for auth, realtime, api-gateway)
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET

# OpenAI (required for ai-service)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# AI provider config (ai-service): 'openai' or an OpenAI-compatible base URL
AI_PROVIDER=openai
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Internal service URLs (interview-service Phase 6)
AI_SERVICE_URL=http://localhost:3012
FILE_STORAGE_SERVICE_URL=http://localhost:3010
# api-gateway: upstream for the /audit proxy (GET /audit/events, admin.audit.view)
AUDIT_SERVICE_URL=http://localhost:3007
# projects-service: time entries, todos, projects, tasks, approvals
PROJECTS_SERVICE_URL=http://localhost:3006
# organisation-service: RBAC context for RemotePermissionGuard (required by projects, audit, etc.)
ORGANISATION_SERVICE_URL=http://localhost:3003

# App
APP_URL=https://teamspaceone.in

# Public base URL used for guest meeting invite links (<PUBLIC_WEB_URL>/join/<token>).
# Falls back to APP_URL on meeting-service. In dev, point it at the web app.
PUBLIC_WEB_URL=http://localhost:8080

# Marketing/landing website
WEB_DOMAIN=teamspaceone.in
WEB_PORT=8080

# Desktop app (Vite build-time)
VITE_SFU_URL=ws://127.0.0.1:8443
# Optional JSON array of STUN/TURN servers; overrides the default STUN.
# VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
VITE_ICE_SERVERS=
# Legacy STUN fallback if VITE_ICE_SERVERS is not set.
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302

# Desktop Next.js web app (build-time / runtime public env)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3005
NEXT_PUBLIC_SFU_URL=ws://localhost:8443
NEXT_PUBLIC_ICE_SERVERS=

# Universal links / App Links (api-gateway serves `/.well-known/*`)
# APPLE_TEAM_ID=XXXXXXXXXX
# ANDROID_CERT_FINGERPRINTS='["<RELEASE_SHA256_FINGERPRINT>","<DEBUG_SHA256_FINGERPRINT>"]'

# Push notifications (notification-service)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json
# APN_KEY=path/to/AuthKey.p8
# APN_KEY_ID=
# APN_TEAM_ID=
# APN_BUNDLE_ID=com.edutapxr.teamspaceone.TeamspaceOne

# Desktop macOS signing / notarization (Tauri)
# APPLE_DEVELOPMENT_TEAM=7K3F8KC3R8
# APPLE_SIGNING_IDENTITY=Developer ID Application: EDUTAPXR TECHNOLOGIES PRIVATE LIMITED (7K3F8KC3R8)
# APPLE_CERTIFICATE=<base64-encoded .p12>
# APPLE_CERTIFICATE_PASSWORD=<p12-password>
# For API-key notarization:
# APPLE_API_KEY=<key-id>
# APPLE_API_ISSUER=<issuer-id>
# APPLE_API_KEY_PATH=/path/to/AuthKey_<key-id>.p8
# For Apple-ID notarization (alternative):
# APPLE_ID=<apple-id-email>
# APPLE_PASSWORD=<app-specific-password>
# APPLE_TEAM_ID=7K3F8KC3R8
# Updater signing:
# TAURI_SIGNING_PRIVATE_KEY=<path-or-content>
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Email (Hostinger SMTP example)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@teamspaceone.in
# SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=no-reply@teamspaceone.in

# Per-organisation email provider encryption key (32+ bytes recommended, used by the organisation service)
# ORGANISATION_EMAIL_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one
