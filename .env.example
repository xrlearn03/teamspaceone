NODE_ENV=development
LOG_LEVEL=info

# API Gateway
GATEWAY_PORT=3000

# Postgres (multi-tenant local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=postgres
# Per-service databases are created by docker/postgres-init (hrms_db included).
# HRMS local dev: DATABASE_URL=postgresql://postgres:$POSTGRES_PASSWORD@localhost:5432/hrms_db?schema=public

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379

# NATS JetStream
NATS_USER=teamspace
NATS_PASSWORD=REPLACE_WITH_STRONG_NATS_PASSWORD
NATS_URL=nats://teamspace:REPLACE_WITH_STRONG_NATS_PASSWORD@localhost:4222

# S3-compatible (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_STRONG_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STRONG_S3_SECRET_KEY
S3_BUCKET=teamspace-one
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Native SFU (voice/video)
SFU_TOKEN_SECRET=REPLACE_WITH_STRONG_SFU_TOKEN_SECRET
# Seconds an SFU join token stays valid (default 4h).
SFU_TOKEN_TTL_SECONDS=14400
# ICE UDP mux port the SFU binds for media (published as UDP in compose).
SFU_UDP_MUX_PORT=10000
# Public IP(s) the SFU advertises as ICE candidates when behind 1:1 NAT.
# Local dev default is 127.0.0.1; set to the server's public IP in deployed envs.
SFU_NAT_1TO1_IPS=127.0.0.1
# Internal control API (recording on/off); meeting-service calls this.
SFU_CONTROL_URL=http://localhost:8445
# Directory inside the SFU where per-track recordings are written before upload.
SFU_RECORDING_DIR=./recordings

# Service-to-service auth (required for all services)
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY

# JWT signing secret (required for auth, realtime, api-gateway)
JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET

# OpenAI (required for ai-service)
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# AI provider config (ai-service): 'openai' or an OpenAI-compatible base URL
AI_PROVIDER=openai
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Internal service URLs (interview-service Phase 6)
AI_SERVICE_URL=http://localhost:3012
FILE_STORAGE_SERVICE_URL=http://localhost:3010

# App
APP_URL=https://teamspaceone.in

# Email (Hostinger SMTP example)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@teamspaceone.in
# SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=no-reply@teamspaceone.in

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one
