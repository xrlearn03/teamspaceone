generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileRecord {
  id             String   @id @default(cuid())
  organisationId String
  workspaceId    String?
  uploaderId     String
  originalName   String
  mimeType       String
  size           Int
  storageKey     String   @unique
  url            String
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@index([workspaceId])
  @@map("files")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}
