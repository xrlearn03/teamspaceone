generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileRecord {
  id             String   @id @default(cuid())
  organisationId String
  workspaceId    String?
  resourceType   String?
  resourceId     String?
  category       String   // avatar, message, project, task, meeting, attachment, ai-document
  uploaderId     String
  originalName   String
  mimeType       String
  size           Int
  bucket         String
  storageKey     String   @unique
  url            String?
  etag           String?
  checksumSha256 String?
  status         String   @default("uploaded") // uploaded, processing, processed, failed
  version        Int      @default(1)
  versionGroupId String?
  folderId       String?
  previewUrl     String?
  thumbnailUrl   String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  previews       FilePreview[]
  externalShares ExternalShare[]
  folder         Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([workspaceId])
  @@index([resourceType, resourceId])
  @@index([category])
  @@index([status])
  @@index([versionGroupId])
  @@index([folderId])
  @@map("files")
}

model Folder {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  category       String   // e.g. hrms
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  files          FileRecord[]
  parent         Folder?    @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]   @relation("FolderToFolder")

  @@index([organisationId])
  @@index([organisationId, category])
  @@index([parentId])
  @@map("folders")
}

model FilePreview {
  id           String     @id @default(cuid())
  fileId       String
  file         FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  previewType  String     // thumbnail, image_preview, text_extract
  organisationId String
  storageKey   String     @unique
  url          String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([fileId])
  @@index([organisationId])
  @@map("file_previews")
}

model ExternalShare {
  id             String     @id @default(cuid())
  fileId         String
  file           FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  organisationId String
  token          String     @unique
  createdBy      String
  expiresAt      DateTime?
  maxViews       Int?
  viewCount      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([fileId])
  @@index([organisationId])
  @@index([token])
  @@map("external_shares")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}
