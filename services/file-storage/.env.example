NODE_ENV=development
LOG_LEVEL=info
PORT=3010
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_db?schema=public
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teamspace-one
# Optional: CDN or public base URL for generated links
# S3_PUBLIC_BASE_URL=http://localhost:9000/teamspace-one
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one-file-storage-service
# Set to "true" to generate HLS streaming previews for uploaded videos (requires ffmpeg in the container/host)
# FILE_HLS_ENABLED=false
