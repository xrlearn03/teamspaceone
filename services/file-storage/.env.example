NODE_ENV=development
LOG_LEVEL=info
PORT=3010
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/file_db?schema=public
NATS_URL=nats://teamspace:REPLACE_WITH_STRONG_NATS_PASSWORD@localhost:4222
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_STRONG_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_STRONG_S3_SECRET_KEY
S3_BUCKET=teamspace-one
# Maximum upload size in bytes (default 200 MiB)
MAX_UPLOAD_BYTES=209715200
# Per-user storage quota in bytes (default 2 GiB); the organisation quota is
# memberCount * STORAGE_QUOTA_PER_USER_BYTES
STORAGE_QUOTA_PER_USER_BYTES=2147483648
# Optional: CDN or public base URL for generated links
# S3_PUBLIC_BASE_URL=http://localhost:9000/teamspace-one
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one-file-storage-service
# Set to "true" to generate HLS streaming previews for uploaded videos (requires ffmpeg in the container/host)
# FILE_HLS_ENABLED=false
ORGANISATION_SERVICE_URL=http://localhost:3003
