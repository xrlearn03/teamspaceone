generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String?
  actorId        String?
  resourceType   String?
  resourceId     String?
  correlationId  String?
  timestamp      String
  storedAt       DateTime @default(now())

  @@index([organisationId])
  @@index([eventType])
  @@index([resourceType, resourceId])
  @@index([storedAt])
  @@map("audit_events")
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String?
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}

model DeadLetterEvent {
  id            String   @id @default(cuid())
  eventId       String?
  eventType     String?
  subject       String
  originalEvent Json
  reason        String
  service       String?
  deliveryCount Int      @default(0)
  payload       Json
  organisationId String?
  createdAt     DateTime @default(now())
  retriedAt     DateTime?
  retryCount    Int      @default(0)
  retries       DeadLetterRetry[]

  @@index([eventId])
  @@index([organisationId])
  @@index([createdAt])
  @@map("dead_letter_events")
}

model DeadLetterRetry {
  id                String        @id @default(cuid())
  deadLetterEventId String
  deadLetterEvent   DeadLetterEvent @relation(fields: [deadLetterEventId], references: [id])
  success           Boolean
  error             String?
  retriedAt         DateTime      @default(now())

  @@index([deadLetterEventId])
  @@map("dead_letter_retries")
}
