{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "paths": {
      "#prisma": ["./node_modules/.prisma/client"],
      "@teamspace-one/authorization": ["./node_modules/@teamspace-one/authorization/dist/index.d.ts"],
      "@teamspace-one/authorization/*": ["./node_modules/@teamspace-one/authorization/dist/*.d.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/main.ts",
    "src/app.module.ts",
    "src/prisma/**/*",
    "src/health/**/*",
    "src/events/events.module.ts",
    "src/events/nats-client.service.ts",
    "src/outbox/**/*",
    "src/meeting/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
