generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id             String              @id @default(cuid())
  organisationId String
  workspaceId    String?
  roomName       String              @unique
  title          String
  description    String?
  type           String              @default("meeting")
  scheduledAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  status         String              @default("scheduled")
  isRecording    Boolean             @default(false)
  recordingEgressId String?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  participants   MeetingParticipant[]
  messages       MeetingMessage[]
  reactions      MeetingReaction[]
  raiseHands     MeetingRaiseHand[]

  @@index([organisationId])
  @@index([workspaceId])
  @@index([status])
  @@map("meetings")
}

model MeetingParticipant {
  id             String   @id @default(cuid())
  meetingId      String
  organisationId String
  userId         String
  joinedAt       DateTime @default(now())
  leftAt         DateTime?
  isScreenSharing Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([organisationId])
  @@index([userId])
  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

model MeetingMessage {
  id             String   @id @default(cuid())
  meetingId      String
  organisationId String
  userId         String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([organisationId])
  @@index([createdAt])
  @@map("meeting_messages")
}

model MeetingReaction {
  id             String   @id @default(cuid())
  meetingId      String
  organisationId String
  userId         String
  emoji          String
  createdAt      DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([organisationId])
  @@map("meeting_reactions")
}

model MeetingRaiseHand {
  id             String   @id @default(cuid())
  meetingId      String
  organisationId String
  userId         String
  raised         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([organisationId])
  @@map("meeting_raise_hands")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}
