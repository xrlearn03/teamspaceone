NODE_ENV=development
LOG_LEVEL=info
PORT=3008
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/notification_db?schema=public
NATS_URL=nats://teamspace:REPLACE_WITH_STRONG_NATS_PASSWORD@localhost:4222
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379
AUTH_SERVICE_URL=http://localhost:3002
APP_URL=https://teamspaceone.in
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one-notification-service

# App URL used in invitation links
# APP_URL=https://teamspaceone.in

# Email delivery (optional; Hostinger example)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@teamspaceone.in
# SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=no-reply@teamspaceone.in
ORGANISATION_SERVICE_URL=http://localhost:3003

# iOS push (APNs)
# APN_KEY=/path/to/AuthKey_<keyId>.p8
# APN_KEY_ID=
# APN_TEAM_ID=
# APN_BUNDLE_ID=com.edutapxr.teamspaceone.TeamspaceOne

# Android push (FCM)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json
