NODE_ENV=development
LOG_LEVEL=info
PORT=3008
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/notification_db?schema=public
NATS_URL=nats://teamspace:REPLACE_WITH_STRONG_NATS_PASSWORD@localhost:4222
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@localhost:6379
AUTH_SERVICE_URL=http://localhost:3002
APP_URL=https://app.teamspace.one
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamspace-one-notification-service

# App URL used in invitation links
# APP_URL=https://app.teamspace.one

