generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships   OrganisationMembership[]
  invitations   Invitation[]
  roles         Role[]
  workspaces    Workspace[]
  tickets       Ticket[]
  assets        Asset[]
  emailProvider OrganisationEmailProvider?

  @@index([ownerId])
  @@map("organisations")
}

model OrganisationEmailProvider {
  id             String       @id @default(cuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  host           String
  port           Int
  secure         Boolean      @default(false)
  user           String?
  encryptedPass  String?      @map("encrypted_pass")
  from           String       @default("no-reply@teamspaceone.in")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("organisation_email_providers")
}

model Role {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  description    String?
  roleCategory   String       @default("member")
  isSystem       Boolean      @default(false) @map("is_system")
  isDefault      Boolean      @default(false)
  createdBy      String?
  permissions    Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships    OrganisationMembership[]
  rolePermissions RolePermission[]
  userRoles      UserRole[]
  roleScopes     RoleScope[]
  tickets        Ticket[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

model OrganisationMembership {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  clientId       String?
  roleId         String
  isGuest        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  dataScopes     DataScope[]

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([userId])
  @@index([clientId])
  @@map("organisation_memberships")
}

model Invitation {
  id             String       @id @default(cuid())
  organisationId String
  clientId       String?
  email          String
  roleId         String
  token          String       @unique
  userId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([token])
  @@index([clientId])
  @@map("invitations")
}

model Workspace {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("workspaces")
}

model Client {
  id             String   @id @default(cuid())
  organisationId String
  clientOrganisationId String?
  name           String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId])
  @@map("clients")
}

model Ticket {
  id             String   @id @default(cuid())
  organisationId String
  subject        String
  description    String
  category       String
  priority       String   @default("medium")
  status         String   @default("new")
  requesterId    String
  assigneeRoleId String
  attachments    Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assigneeRole   Role     @relation(fields: [assigneeRoleId], references: [id])

  @@index([organisationId])
  @@index([organisationId, requesterId])
  @@index([organisationId, assigneeRoleId])
  @@map("tickets")
}

model Asset {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  category       String?
  assetTag       String?
  serialNumber   String?
  status         String            @default("available")
  purchaseDate   DateTime?         @db.Date
  purchaseCost   Float?
  warrantyEnd    DateTime?         @db.Date
  vendor         String?
  notes          String?
  assignments    AssetAssignment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organisationId])
  @@index([organisationId, status])
  @@map("assets")
}

model AssetAssignment {
  id             String   @id @default(cuid())
  organisationId String
  assetId        String
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assigneeUserId String
  assignedBy     String?
  assignedAt     DateTime @default(now())
  returnedAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@index([assetId])
  @@index([organisationId, assigneeUserId])
  @@map("asset_assignments")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String                 @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime               @default(now())
  membership   OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("user_roles")
}

model DataScope {
  id           String                 @id @default(cuid())
  membershipId String
  module       String
  scope        String
  scopeValue   String?
  createdAt    DateTime               @default(now())
  membership   OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([module, scope])
  @@map("data_scopes")
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RoleScope {
  id           String   @id @default(cuid())
  roleId       String
  module       String
  scope        String
  scopeValue   String?
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([module, scope])
  @@map("role_scopes")
}
