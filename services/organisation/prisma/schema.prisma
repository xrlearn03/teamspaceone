generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships OrganisationMembership[]
  invitations Invitation[]
  roles       Role[]
  workspaces  Workspace[]

  @@index([ownerId])
  @@map("organisations")
}

model Role {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  description    String?
  permissions    Json         @default("[]")
  isSystem       Boolean      @default(false)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships    OrganisationMembership[]
  rolePermissions RolePermission[]
  userRoles      UserRole[]
  roleScopes     RoleScope[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("roles")
}

model OrganisationMembership {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  clientId       String?
  roleId         String
  isGuest        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  dataScopes     DataScope[]

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([userId])
  @@index([clientId])
  @@map("organisation_memberships")
}

model Invitation {
  id             String       @id @default(cuid())
  organisationId String
  clientId       String?
  email          String
  roleId         String
  token          String       @unique
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([token])
  @@index([clientId])
  @@map("invitations")
}

model Workspace {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("workspaces")
}

model Client {
  id             String   @id @default(cuid())
  organisationId String
  clientOrganisationId String?
  name           String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organisationId])
  @@map("clients")
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String                 @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime               @default(now())
  membership   OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("user_roles")
}

model DataScope {
  id           String                 @id @default(cuid())
  membershipId String
  module       String
  scope        String
  scopeValue   String?
  createdAt    DateTime               @default(now())
  membership   OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([module, scope])
  @@map("data_scopes")
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RoleScope {
  id           String   @id @default(cuid())
  roleId       String
  module       String
  scope        String
  scopeValue   String?
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([module, scope])
  @@map("role_scopes")
}
