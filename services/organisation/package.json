{
  "name": "@teamspace-one/organisation-service",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "imports": {
    "#prisma": {
      "types": "./node_modules/.prisma/client/index.d.ts",
      "default": "./node_modules/.prisma/client/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:permissions": "nest build && node dist/seed/seed-permissions.js",
    "db:seed:rbac": "nest build && node dist/seed/seed-rbac.js",
    "db:seed:platform": "nest build && node dist/seed/seed-platform.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "@teamspace-one/event-contracts": "workspace:*",
    "@teamspace-one/logger": "workspace:*",
    "@teamspace-one/opentelemetry": "workspace:*",
    "@teamspace-one/organisation-context": "workspace:*",
    "@teamspace-one/authorization": "workspace:*",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.4.0",
    "nats": "^2.28.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
