generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiSummary {
  id             String   @id @default(cuid())
  organisationId String
  resourceType   String
  resourceId     String
  prompt         String
  result         String
  model          String
  createdAt      DateTime @default(now())

  @@index([organisationId])
  @@unique([resourceType, resourceId])
  @@map("ai_summaries")
}

model InboxEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String?
  processedAt    DateTime @default(now())

  @@index([eventId])
  @@index([organisationId])
}

model OutboxEvent {
  id             String    @id @default(cuid())
  eventId        String    @unique
  eventType      String
  subject        String
  payload        Json
  organisationId String
  createdAt      DateTime  @default(now())
  publishedAt    DateTime?

  @@index([publishedAt])
  @@index([organisationId])
}
