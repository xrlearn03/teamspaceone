{
  "name": "@teamspace-one/authorization",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./guard": {
      "import": {
        "types": "./dist/esm/guard.d.ts",
        "default": "./dist/esm/guard.js"
      },
      "require": {
        "types": "./dist/guard.d.ts",
        "default": "./dist/guard.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/esm/nest.d.ts",
        "default": "./dist/esm/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      }
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.5.4"
  }
}
