{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only permissions",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "ws://localhost:*/*",
      "tauri://localhost/*",
      "http://tauri.localhost/*"
    ]
  },
  "permissions": [
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister",
    "process:default",
    "updater:default"
  ]
}
