{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://34.93.42.133:*/*",
      "ws://34.93.42.133:*/*"
    ]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/*" },
        { "url": "http://34.93.42.133:3000/*" },
        { "url": "http://34.93.42.133:3005/*" },
        { "url": "http://34.93.42.133:9000/*" }
      ]
    },
    "opener:default",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister",
    "notification:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default",
    "core:window:allow-set-focus",
    "native-media"
  ]
}
