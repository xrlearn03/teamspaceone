{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:1420/*",
      "http://localhost:3000/*",
      "http://localhost:3005/*",
      "http://localhost:5173/*",
      "ws://localhost:7880/*",
      "ws://localhost:8443/*",
      "http://34.93.42.133:3000/*",
      "http://34.93.42.133:3005/*",
      "ws://34.93.42.133:7880/*",
      "ws://34.93.42.133:8443/*"
    ]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3000/*" },
        { "url": "http://localhost:3005/*" },
        { "url": "http://localhost:1420/*" },
        { "url": "http://localhost:5173/*" },
        { "url": "http://34.93.42.133:3000/*" },
        { "url": "http://34.93.42.133:3005/*" }
      ]
    },
    "opener:default",
    "dialog:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister",
    "notification:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "updater:default",
    "core:window:allow-set-focus",
    "native-media",
    "screen-share"
  ]
}
