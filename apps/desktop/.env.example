# API Gateway URL used by the desktop client
VITE_GATEWAY_URL=http://localhost:3000

# Realtime service WebSocket URL
VITE_REALTIME_URL=http://localhost:3005

# LiveKit server WebSocket URL
VITE_LIVEKIT_URL=ws://localhost:7880

# SFU server WebSocket URL
VITE_SFU_URL=ws://localhost:8443

# Optional STUN/TURN servers for non-local WebRTC deployments
# VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302
# VITE_TURN_SERVER_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=username
# VITE_TURN_CREDENTIAL=credential
