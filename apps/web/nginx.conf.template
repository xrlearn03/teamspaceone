server {
    listen 80;
    server_name www.${WEB_DOMAIN};
    return 301 https://${WEB_DOMAIN}$request_uri;
}

server {
    listen 80 default_server;
    server_name ${WEB_DOMAIN};
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/rss+xml
        application/atom+xml
        image/svg+xml;

    if ($http_x_forwarded_proto = "http") {
        return 301 https://${WEB_DOMAIN}$request_uri;
    }

    # Public gateway endpoints exposed on the marketing domain.
    # The desktop client uses app.${WEB_DOMAIN}; these paths let the public
    # web pages (candidate apply, accept invite, etc.) talk to the API.
    location /interview/public {
        proxy_pass http://api-gateway:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Guest meeting join (signed link -> guest SFU token).
    location /meetings/public {
        proxy_pass http://api-gateway:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SFU signaling WebSocket for browser guests (media runs over UDP/ICE).
    location = /sfu {
        proxy_pass http://sfu:8443/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /auth/redeem {
        proxy_pass http://api-gateway:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /downloads/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
